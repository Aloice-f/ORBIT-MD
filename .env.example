# ---------- Bot (npm start) ----------
# Session ID from your pairing site. (Or put it in a file called session.txt.)
SESSION_ID=
BOT_NAME=Orbit-MD
OWNER_NAME=Owner
# Menu picture: leave empty to use assets/menu.jpg, or set a direct image link
MENU_IMAGE_URL=
PREFIX=.
# Extra owner numbers, digits only, comma separated. The linked number is always an owner.
OWNER_NUMBER=254700000000
MODE=public
TIMEZONE=Africa/Nairobi
# Shown in the console if no session is found
PAIR_SITE_URL=

# ---------- Keep settings and keys across restarts (optional, YOUR own Supabase project) ----------
# Run supabase/schema.sql once in your project, then fill these in. Use the service_role key and keep it secret.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------- AI commands (optional overrides, defaults use the free Pollinations service) ----------
# AI_BASE_URL=https://text.pollinations.ai
# AI_IMAGE_URL=https://image.pollinations.ai/prompt

# ---------- Pairing website (npm run pair) ----------
# Only set PORT for the pairing site. If the bot sees PORT it also opens that port.
# PORT=3000
# How many people may be mid-pairing at once
# MAX_PAIRINGS=10
